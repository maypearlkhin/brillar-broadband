# Backend (Express API) — copy to `.env` in this folder:
#   cp .env.example .env   (Unix)   or copy manually on Windows
#
# Local dev (`npm run dev -w backend`): default PORT 4000.
# PM2 (`ecosystem.config.cjs`): uses PORT 4012 from PM2 env.

NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/brillar-broadband

# Must match the JWT_SECRET used by the Next.js frontend (middleware + cookies).
JWT_SECRET=replace-this-with-a-long-random-secret

# Optional: comma-separated browser origins for CORS (e.g. http://localhost:3000,http://localhost:3013).
# Leave unset to reflect request origin in development / broad tooling access.
# CORS_ORIGIN=http://localhost:3000
