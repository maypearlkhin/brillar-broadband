# Next.js (frontend) — copy to `.env.local` in this folder (Next loads it automatically):
#   cp .env.example .env.local   (Unix)   or copy manually on Windows

NODE_ENV=development

# Port for `next dev` / `next start` when not overridden by CLI (optional).
PORT=3000

# Public URL of the **Express API** — read by axios in both browser and Server Components.
# Dev:    http://localhost:4000
# Prod:   https://yourdomain.com         (if API is reverse-proxied at /api on the same site)
#         https://api.yourdomain.com     (if API is on a subdomain — backend cookie must allow CORS)
NEXT_PUBLIC_URL=http://localhost:4000

# Same secret as backend JWT signing — required for middleware route guards and session verification.
JWT_SECRET=replace-this-with-a-long-random-secret

# Public URL of this site (links, metadata). Match your dev or production host.
NEXT_PUBLIC_APP_URL=http://localhost:3000
