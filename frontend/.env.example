# Next.js (frontend) — copy to `.env.local` in this folder (Next loads it automatically):
#   cp .env.example .env.local   (Unix)   or copy manually on Windows
#
# Local dev (`npm run dev -w frontend`): app on http://localhost:3000, API on 4000 by default.
# PM2: set PORT=3013 in `ecosystem.config.cjs` (or omit if you rely on `.env`). Use BACKEND_URL below
# to match the API port (e.g. BACKEND_URL=http://127.0.0.1:4010 when the API listens on 4010).

NODE_ENV=development

# Port for `next dev` / `next start` when not overridden by CLI (optional).
PORT=3000

# Where the Node API runs — used for next.config.mjs rewrites and Server Component fetch() to the API.
# Loaded at both `next build` (rewrites) and `next start` — set this before building for production if the URL
# differs from localhost (same machine as PM2: e.g. http://127.0.0.1:4010).
BACKEND_URL=http://127.0.0.1:4000

# Same secret as backend JWT signing — required for middleware route guards and session verification.
JWT_SECRET=replace-this-with-a-long-random-secret

# Public URL of this site (links, metadata). Match your dev or production host.
NEXT_PUBLIC_APP_URL=http://localhost:3000
