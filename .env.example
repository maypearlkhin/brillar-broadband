# =============================================================================
# Brillar Broadband — root `.env.example` (reference only)
# =============================================================================
# Copy app-specific templates into real env files (these are what Node / Next load):
#
#   backend/.env.example   →  backend/.env
#   frontend/.env.example  →  frontend/.env.local
#
# JWT_SECRET must be identical in backend and frontend.
#
# PM2 (see ecosystem.config.cjs): API 4012, web 3013 — use BACKEND_URL=http://127.0.0.1:4012 in frontend.
# =============================================================================

# -----------------------------------------------------------------------------
# backend/.env   (Express API)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/brillar-broadband
JWT_SECRET=replace-this-with-a-long-random-secret
# Optional:
# CORS_ORIGIN=http://localhost:3000,http://localhost:3013

# -----------------------------------------------------------------------------
# frontend/.env.local   (Next.js)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
BACKEND_URL=http://127.0.0.1:4000
JWT_SECRET=replace-this-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
