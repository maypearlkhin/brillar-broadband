{
  "openapi": "3.0.3",
  "info": {
    "title": "Brillar Agent Plans API",
    "description": "Public **catalogue** endpoints for agents. **Purchasing and cancelling** subscriptions are documented in **Brillar_Agent_Personal_API_Spec.json** (`POST /api/agent/buy-plan`, `POST /api/agent/cancel-plan`) and share handlers with the web app.\n\nBilling snapshots: **Brillar_Agent_Billing_API_Spec.json**.",
    "version": "1.2.1",
    "contact": {
      "name": "Brillar API Support",
      "email": "api-support@brillarbroadband.com"
    }
  },
  "servers": [
    {
      "url": "https://api-brillarbroadband.atenxion.ai",
      "description": "Production server"
    }
  ],
  "paths": {
    "/api/agent/all-plans": {
      "get": {
        "summary": "List all active broadband plans",
        "description": "Returns every **active** retail plan sorted by category order, then plan order, then price — same handler as used by the storefront. Response uses **`{ success: true, data: Plan[] }`** (not a bare array). No authentication.",
        "tags": ["Public – Catalogue"],
        "responses": {
          "200": {
            "description": "Active broadband plans fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AllPlansEnvelope" },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": "plan_004",
                      "name": "100Mbps Essential",
                      "monthlyPrice": 32,
                      "downloadSpeedMbps": 100,
                      "price90Days": 111,
                      "price180Days": 120,
                      "price365Days": 260,
                      "features": ["Unlimited data"],
                      "categoryId": "res_everyday",
                      "categoryTitle": "Residential · Everyday fibre",
                      "categorySortOrder": 0,
                      "planSortOrder": 0,
                      "isActive": true
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Plan": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "fibre_pro_500" },
          "name": { "type": "string" },
          "monthlyPrice": { "type": "number" },
          "downloadSpeedMbps": { "type": "number" },
          "price90Days": { "type": "number" },
          "price180Days": { "type": "number" },
          "price365Days": { "type": "number" },
          "features": {
            "type": "array",
            "items": { "type": "string" }
          },
          "categoryId": { "type": "string" },
          "categoryTitle": { "type": "string" },
          "categorySortOrder": { "type": "number" },
          "planSortOrder": { "type": "number" },
          "isActive": { "type": "boolean", "example": true }
        }
      },
      "AllPlansEnvelope": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Plan" }
          }
        },
        "required": ["success", "data"]
      }
    }
  },
  "tags": [
    {
      "name": "Public – Catalogue",
      "description": "Read-only catalogue; no Bearer token."
    }
  ]
}
