{
  "openapi": "3.0.3",
  "info": {
    "title": "Brillar Agent Announcements & Notices API",
    "description": "Public agent routes for **network incidents** and **company notices** (no authentication).\n\n**Related:** catalogue → Plans spec; account/checkout → Personal + Billing specs; appointments → Scheduling spec.",
    "version": "1.1.1",
    "contact": {
      "name": "Brillar API Support",
      "email": "api-support@brillarbroadband.com"
    }
  },
  "servers": [
    {
      "url": "https://api-brillarbroadband.atenxion.ai",
      "description": "Production server"
    }
  ],
  "paths": {
    "/api/agent/announcements-impacts": {
      "get": {
        "summary": "Get All Announcements (Impacts)",
        "description": "Retrieves all network incidents, separated into active and resolved impacts.",
        "tags": [
          "Public Endpoints"
        ],
        "responses": {
          "200": {
            "description": "Impacts fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImpactsResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "activeImpacts": [
                      {
                        "id": "674a1b2c3d4e5f6a7b8c9d01",
                        "country": "Singapore",
                        "district": "Jurong East",
                        "postalCode": "609606",
                        "message": "Planned maintenance may cause brief outages overnight.",
                        "createdAt": "2026-05-10T08:00:00.000Z",
                        "resolvedAt": null
                      }
                    ],
                    "resolvedImpacts": [
                      {
                        "id": "674a1b2c3d4e5f6a7b8c9d02",
                        "country": "Singapore",
                        "district": "Jurong East",
                        "postalCode": "609606",
                        "message": "Fiber link restored after vendor repair.",
                        "createdAt": "2026-05-08T08:00:00.000Z",
                        "resolvedAt": "2026-05-09T12:00:00.000Z"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/resolved-histories": {
      "get": {
        "summary": "List resolved incidents (history only)",
        "description": "Returns **past** resolved network incidents (**`resolvedAt` set), newest resolution first.** Flat list suitable for timelines. Distinct from `GET /api/agent/announcements-impacts`, which returns **`activeImpacts`** and **`resolvedImpacts`** nested under `data`.",
        "tags": ["Public Endpoints"],
        "responses": {
          "200": {
            "description": "Resolved incident history fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolvedHistoriesResponse"
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": "674a1b2c3d4e5f6a7b8c9d02",
                      "country": "Singapore",
                      "district": "Jurong East",
                      "postalCode": "609606",
                      "message": "Fiber link restored after vendor repair.",
                      "createdAt": "2026-05-08T08:00:00.000Z",
                      "resolvedAt": "2026-05-09T12:00:00.000Z"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/notices": {
      "get": {
        "summary": "Get Notices",
        "description": "Retrieves all active general announcements/notices.",
        "tags": [
          "Public Endpoints"
        ],
        "responses": {
          "200": {
            "description": "Notices fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoticesResponse"
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": "674a1b2c3d4e5f6a7b8c9d03",
                      "message": "Brillar office closed on the next public holiday; support remains online.",
                      "createdAt": "2026-05-01T10:00:00.000Z"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Impact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the incident"
          },
          "country": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ImpactsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "activeImpacts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Impact"
                }
              },
              "resolvedImpacts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Impact"
                }
              }
            }
          }
        }
      },
      "Notice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NoticesResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notice"
            }
          }
        }
      },
      "ResolvedHistoriesResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "array",
            "description": "Resolved incidents only, sorted newest `resolvedAt` first.",
            "items": {
              "$ref": "#/components/schemas/Impact"
            }
          }
        },
        "required": ["success", "data"]
      }
    }
  },
  "tags": [
    {
      "name": "Public Endpoints",
      "description": "Public APIs that do not require authentication"
    }
  ]
}
